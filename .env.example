# =============================================================================
# 挑战杯 2026 数学推理智能体 — 环境变量模板
# =============================================================================
# 使用方式：复制为 .env 并填入实际值。
#   cp .env.example .env
# .env 已加入 .gitignore，不会被提交到仓库。
# =============================================================================

# 必填：Intern API 密钥（不要加 "Bearer " 前缀，客户端会自动补全）
INTERN_API_KEY=your_api_key_here

# 可选：API 地址（默认 https://chat.intern-ai.org.cn/api/v1/chat/completions）
# INTERN_API_BASE=https://chat.intern-ai.org.cn/api/v1/chat/completions

# 可选：模型名称（默认 intern-s2-preview-397b；legacy intern-s2-preview 当前指向较小模型）
# INTERN_MODEL=intern-s2-preview-397b
# 可选：是否显式指定深度思考；留空表示使用 397B API 默认值（开启）
# INTERN_THINKING_MODE=true

# 可选：单次请求超时秒数（默认 30；397B 长推理本地诊断建议先用 120）
# INTERN_TIMEOUT_SECONDS=30

# 可选：失败重试次数（默认 1）
# INTERN_RETRY_COUNT=1
